{
  "name": "inventory-pro-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "config:check": "expo config --type public --json > /dev/null",
    "deps:check": "expo install --check",
    "eas:init": "eas init",
    "eas:credentials": "eas credentials",
    "eas:build:dev": "eas build --profile development --platform android",
    "eas:build:preview": "eas build --profile preview --platform android",
    "eas:build:prod": "eas build --profile production --platform android",
    "eas:update:preview": "eas update --channel preview",
    "eas:update:prod": "eas update --channel production",
    "eas:submit:prod": "eas submit --profile production --platform android",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo-google-fonts/figtree": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.1.0",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.9",
    "expo-dev-client": "~58.0.22",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.10",
    "expo-print": "~58.0.9",
    "expo-router": "~58.0.33",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.24",
    "expo-splash-screen": "~58.0.15",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.23",
    "lucide-react-native": "^1.73.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-bluetooth-classic": "^1.73.0-rc.17",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-tcp-socket": "^6.4.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.25",
    "drizzle-kit": "^0.31.11",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-bluetooth-classic",
          "react-native-tcp-socket"
        ]
      }
    }
  }
}
