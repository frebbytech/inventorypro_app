{
  "expo": {
    "name": "Inventory Pro",
    "slug": "inventory-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "inventorypro",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.frebbytech.inventorypro",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Inventory Pro to access your camera to scan product barcodes and attach product photos.",
        "NSBluetoothAlwaysUsageDescription": "Allow Inventory Pro to connect to paired Bluetooth thermal receipt printers and POS scanners.",
        "NSLocalNetworkUsageDescription": "Allow Inventory Pro to send ESC/POS receipts to LAN/Wi-Fi thermal printers on your local network.",
        "UIBackgroundModes": ["remote-notification"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.frebbytech.inventorypro",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-sqlite",
      "expo-dev-client",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F5F5",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#070B13",
            "image": "./assets/icon.png"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Inventory Pro to access your camera to scan product barcodes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3B82F6"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "02faeae4-f130-4f98-9dd3-9e2f422aeeb8"
      }
    },
    "owner": "frebby-tech"
  }
}
