# Database configuration
DATABASE_URL=./inventory_pro.db
DATABASE_AUTH_TOKEN=

# Authentication & Session signing
JWT_SECRET=replace-with-a-strong-random-secret
COOKIE_NAME=auth_session

# Super Admin portal seed credentials (used on /super-admin/login)
SUPER_ADMIN_EMAIL=superadmin@inventorypro.app
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=replace-with-super-admin-password

# Global static web backend URL for mobile sync across all tenants
MOBILE_API_BASE_URL=
EXPO_PUBLIC_API_BASE_URL=
