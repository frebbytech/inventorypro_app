{
  "name": "InventoryPro",
  "version": "0.1.0",
  "description": "A responsive inventory management app for tracking stock, orders, and assets efficiently.",
  "author": "Frebbytech Solutions <frebbytech@gmail.com>",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "clean": "rimraf dist .next dist-electron",
    "clear": "rimraf .next dist-electron",
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "dev:next": "next dev -p 3000 -H 0.0.0.0",
    "dev:electron": "tsc -p tsconfig.electron.json -w",
    "dev:desktop": "npm run clear && concurrently \"npm run dev:next\" \"npm run dev:electron\" \"wait-on http://localhost:3000 dist-electron/main.js && cross-env NODE_ENV=development electron .\"",
    "build": "next build --webpack",
    "build:next": "bun --bun next build && bun --bun -e \"const fs = require('fs'); const path = require('path'); const { execSync } = require('child_process'); const root = path.resolve('.'); const saDir = path.join(root, '.next/standalone'); fs.cpSync(path.join(root, 'public'), path.join(saDir, 'public'), { recursive: true }); fs.cpSync(path.join(root, '.next/static'), path.join(saDir, '.next/static'), { recursive: true }); const tempDir = path.join(root, 'temp-prod-deps'); fs.mkdirSync(tempDir, { recursive: true }); fs.copyFileSync(path.join(root, 'package.json'), path.join(tempDir, 'package.json')); fs.copyFileSync(path.join(root, 'bun.lockb'), path.join(tempDir, 'bun.lockb')); execSync('bun install --production', { cwd: tempDir, stdio: 'inherit' }); const destMod = path.join(saDir, 'node_modules'); fs.rmSync(destMod, { recursive: true, force: true }); fs.cpSync(path.join(tempDir, 'node_modules'), destMod, { recursive: true }); fs.rmSync(tempDir, { recursive: true, force: true });\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "package": "npm run electron:deps && npm run clean && npm run build:next && npm run build:electron && electron-builder --win nsis --x64 --config electron-builder.yml",
    "db:generate": "npx knex migrate:latest --knexfile knexfile.ts",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "electron:deps": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@hookform/resolvers": "^5.4.0",
    "@libsql/knex-libsql": "^0.1.0",
    "@number-flow/react": "^0.6.0",
    "@radix-ui/react-accordion": "^1.2.14",
    "@radix-ui/react-alert-dialog": "^1.1.17",
