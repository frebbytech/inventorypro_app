    "jose": "^6.2.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "knex": "^3.3.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.21.0",
    "match-sorter": "^8.3.0",
    "motion": "^14.7.1",
